# CHANAKYA web app configuration (copy to apps/web/.env.local for local dev).
# NEXT_PUBLIC_* vars are exposed to the browser - never put secrets here.

# Base URL of the Go backend API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Server-side Gemini key used by the AI Summary server action (app/actions.ts)
# and the /api/ai/stream route. Next.js only reads env files inside apps/web,
# so backend/.env is NOT picked up here - this must be set separately.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
